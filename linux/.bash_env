#!/bin/bash

export EDITOR=vim
export PAGER=less

export
# fzf config
if type -P fzf &>/dev/null;then

if fd -V &>/dev/null;then
	export FZF_DEFAULT_COMMAND='fd --type file --follow --hidden --exclude .git'
fi

fi
# go config
export GOPATH=$HOME/go

# starship prompt (replaces powerline-go: better performance and shell
# compatibility). Config linked to ~/.config/starship.toml by the setup
# scripts; without starship the plain PS1 from ~/.bashrc stays in effect.
if type -P starship >/dev/null; then
    eval "$(starship init bash)"
fi
